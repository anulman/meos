# Embedding generation is opt-in; enabling sends indexed planning text to OpenAI.
# @type=boolean
MEOS_SEARCH_ENABLED=false
# @type=url
MEOS_PUBLIC_ORIGIN=https://meos.example.com
# @sensitive @type=string
MEOS_SEARCH_AGENT_TOKEN=
# @sensitive @type=string
MEOS_OPENAI_API_KEY=

# The installed unit binds the admitted native socket here; do not use the public browser route.
# @type=string
MEOS_SEARCH_SOCKET=/run/meos-search/backend.sock
