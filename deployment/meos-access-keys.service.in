[Unit]
Description=Refresh MeOS public Access signing keys
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 @RELEASE@/scripts/production-access-keys.py @IDENTITY@ @ACCESS_KEYS@
User=root
UMask=0022
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=@ACCESS_KEYS@
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
