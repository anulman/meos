[Unit]
Description=MeOS bounded embedding indexing
Requires=meos-backend.service
After=network-online.target meos-backend.service
PartOf=meos-backend.service
[Service]
Type=oneshot
User=meos-search
WorkingDirectory=/opt/meos/current
EnvironmentFile=/etc/meos/search.env
ExecStart=/usr/bin/node scripts/search-worker.mjs
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
BindReadOnlyPaths=@BACKEND_SOCKET@:/run/meos-search/backend.sock
[Install]
WantedBy=multi-user.target
