[Unit]
Description=MeOS socket-only relay (no database access)
Requires=@PREFIX@-backend.service
After=@PREFIX@-backend.service
PartOf=@PREFIX@-backend.service

[Service]
# Reserved UID/GID has no NSS account; drop identity and all caps before proxy exec.
ExecStart=/usr/bin/setpriv --reuid=61006 --regid=61006 --clear-groups --bounding-set=-all --inh-caps=-all --ambient-caps=-all /usr/lib/systemd/systemd-socket-proxyd /run/native/backend.sock
PrivateNetwork=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
TemporaryFileSystem=/run
BindReadOnlyPaths=@NATIVE_SOCKET@:/run/native/backend.sock
InaccessiblePaths=/mnt /var/lib
Restart=on-failure
RestartSec=2
