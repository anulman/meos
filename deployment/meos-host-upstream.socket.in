[Unit]
Description=Private MeOS delegated-owner Unix upstream
PartOf=@PREFIX@-backend.service
After=@PREFIX@-backend.service

[Socket]
ListenStream=/run/meos-host/backend.sock
SocketUser=@GATEWAY_USER@
SocketMode=0600
# The bridge opens a directory FD; only the socket, not this directory, is private.
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=@PREFIX@-backend.service
